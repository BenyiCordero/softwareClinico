# HTTP
PORT=3000
CORS_ORIGINS=http://localhost:5173

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_NAME=quirurgia

# JWT
JWT_SECRET=change-me-to-a-long-random-secret
JWT_REFRESH_SECRET=change-me-to-another-long-random-secret
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Authentication cookies
# false is required for local HTTP development; use true with HTTPS.
COOKIE_SECURE=false
COOKIE_ACCESS_MAX_AGE=900000
COOKIE_REFRESH_MAX_AGE=604800000

# create-admin script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_USERNAME=admin
ADMIN_FIRST_NAME=Administrador
ADMIN_LAST_NAME=Sistema
ADMIN_BIRTH_DATE=1990-01-01
ADMIN_SEX=UNSPECIFIED
ADMIN_PHONE=5555555555
# Optional: leave empty for a global role assignment.
ADMIN_BRANCH_ID=
